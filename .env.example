# Sent as X-API-Key by the smoke/concurrency scripts (and required from Level 2).
API_KEY=change-me

# Postgres in compose. The api container builds its DATABASE_URL from these.
POSTGRES_USER=clinic
POSTGRES_PASSWORD=clinic
POSTGRES_DB=clinic

# Used when running alembic/pytest on the host against the compose db.
DATABASE_URL=postgresql+asyncpg://clinic:clinic@localhost:5452/clinic
TEST_DATABASE_URL=postgresql+asyncpg://clinic:clinic@localhost:5452/clinic_test

# Redis for the rate limit (compose sets REDIS_URL for the api container itself).
REDIS_URL=redis://localhost:6396/0
# Tests use their own Redis database number, flushed between tests.
TEST_REDIS_URL=redis://localhost:6396/15
